# GRAMPS API configuration for data loading scripts
GRAMPS_API_BASE_URL=

# Authentication credentials for GRAMPS Web API
# Use standard username/password login via the /token endpoint.
# Do not commit real credentials into version control.
GRAMPS_API_USER=
GRAMPS_API_PASSWORD=

GRAMPS_API_PERSON_QUERY_PARAM=gramps_id
GRAMPS_API_PERSON_SEARCH_PATH=people
GRAMPS_API_EVENT_DETAIL_PATH=events/{handle}
GRAMPS_API_PLACE_DETAIL_PATH=places/{handle}
GRAMPS_API_TIMEOUT=30
