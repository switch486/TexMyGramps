# GRAMPS API configuration for data loading scripts
# Copy this file to gramps_api.local.env and fill in your credentials
# The .local.env file will be used for sensitive data and is not tracked by git

# ============================================================================
# SENSITIVE DATA (put in gramps_api.local.env, NOT here)
# ============================================================================
# Uncomment and configure these in gramps_api.local.env:
# GRAMPS_API_BASE_URL=http://your-gramps-server:5449/api
# GRAMPS_API_USER="your_username"
# GRAMPS_API_PASSWORD="your_password"

# ============================================================================
# NON-SENSITIVE CONFIGURATION (safe to commit)
# ============================================================================

# Query parameter for person search
GRAMPS_API_PERSON_QUERY_PARAM=gramps_id

# API endpoints
GRAMPS_API_PERSON_SEARCH_PATH=people
GRAMPS_API_EVENT_DETAIL_PATH=events/{handle}
GRAMPS_API_PLACE_DETAIL_PATH=places/{handle}

# Request timeout in seconds
GRAMPS_API_TIMEOUT=30
